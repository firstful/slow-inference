    #[test]
    fn test_gelu() {
        assert!((Model::gelu(0.0) - 0.0).abs() < 1e-6);
        assert!((Model::gelu(1.0) - 0.8411920071).abs() < 1e-9);
        assert!((Model::gelu(-1.0) + 0.1588080227).abs() < 1e-9);
        assert!((Model::gelu(2.0) - 1.9545977116).abs() < 1e-9);
    }

    #[test]
    fn test_layernorm() {
        let x = [1.0, 2.0, 3.0, 4.0];
        let w = [1.0, 1.0, 1.0, 1.0];
        let b = [0.0, 0.0, 0.0, 0.0];
        let eps = 1e-5;
        let y = Model::layernorm(&x, &w, &b, eps);
        assert!((y[0] + 1.3416).abs() < 1e-4);
        assert!((y[1] + 0.4472).abs() < 1e-4);
        assert!((y[2] - 0.4472).abs() < 1e-4);
        assert!((y[3] - 1.3416).abs() < 1e-4);
    }

